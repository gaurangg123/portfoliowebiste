{
  // Type-checks the browser scripts (JavaScript with JSDoc, // @ts-check) and the
  // Playwright tests. Nothing is emitted: the site ships the JavaScript as written.
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "commonjs",
    "moduleResolution": "node",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": ["node"]
  },
  "include": ["src/scripts/**/*.js", "src/scripts/globals.d.ts", "qa/playwright/**/*.ts", "qa/playwright.config.ts"]
}
